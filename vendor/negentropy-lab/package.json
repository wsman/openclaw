{
  "name": "negentropy-lab",
  "version": "7.6.0",
  "description": "Negentropy-Lab Control Plane Server",
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:legacy": "tsx watch src/index.ts",
    "dev:colyseus": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:legacy\"",
    "build": "npm run build:legacy && npm run build:server",
    "build:legacy": "tsc -p tsconfig.build.json",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build:clean": "rimraf dist && npm run build",
    "start": "node dist/server/index.js",
    "start:legacy": "node dist/index.js",
    "start:colyseus": "node dist/server/index.js",
    "test": "vitest",
    "test:authority": "vitest run --config vitest.authority.config.mjs",
    "test:authority:coverage": "vitest run --config vitest.authority.config.mjs --coverage",
    "test:jest": "jest",
    "test:all": "npm run test && npm run test:jest",
    "test:coverage": "vitest --coverage",
    "test:coverage:jest": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rimraf dist node_modules/.vite node_modules/.vite-temp",
    "prepare": "husky",
    "check:constitution": "node scripts/checks/constitution-check.js",
    "check:consistency": "node scripts/checks/consistency-check.js --strict",
    "check:contract": "node scripts/checks/contract-count-check.js",
    "check:contract:strict": "node scripts/checks/contract-count-check.js --enforce",
    "check:contract:drift": "node scripts/checks/contract-drift-audit.js --enforce",
    "check:integration:config": "tsx scripts/checks/check-integration-config.ts",
    "report:contract:monthly": "node scripts/reports/contract-monthly-summary.js",
    "report:testdebt:skip": "node scripts/reports/skip-test-governance.js",
    "test:perf": "bash ./scripts/perf/run-performance-tests.sh --quick",
    "report:perf:weekly": "node scripts/reports/perf-weekly-report.js",
    "report:perf:trend": "node scripts/reports/perf-trend-audit.js",
    "phase14:e2e": "tsx scripts/ops/phase14-e2e-integration.ts",
    "phase14:perf": "tsx scripts/perf/phase14-performance-baseline.ts",
    "phase15:grayscale": "tsx scripts/ops/phase15-grayscale-rollout.ts",
    "ops:preflight": "bash ./scripts/ops/deploy-preflight-check.sh --env staging",
    "ops:preflight:prod": "bash ./scripts/ops/deploy-preflight-check.sh --env production --skip-tests",
    "ops:deploy:smoke": "tsx ./scripts/ops/ops-production-smoke.ts",
    "ops:authority:report": "tsx ./scripts/reports/authority-ops-report.ts",
    "ops:authority:recovery:drill": "tsx ./scripts/authority/authority-recovery-drill.ts",
    "ops:authority:baseline": "tsx ./scripts/perf/authority-performance-baseline.ts",
    "ops:authority:cluster:monitor": "tsx ./scripts/authority/authority-cluster-monitoring.ts",
    "ops:authority:cluster:validate": "tsx ./scripts/authority/authority-cluster-validation.ts",
    "ops:authority:cluster:rehearshal": "tsx ./scripts/authority/authority-cluster-rehearshal.ts",
    "ops:authority:staging:up": "docker compose -f docker-compose.authority-staging.yml up -d --build",
    "ops:authority:staging:down": "docker compose -f docker-compose.authority-staging.yml down -v",
    "ops:rollback:verify": "bash ./scripts/ops/rollback-verify.sh",
    "ops:fault:injection": "tsx ./scripts/ops/ops-fault-injection.ts",
    "launch": "tsx scripts/launcher/launcher-cli.ts",
    "launch:dev": "tsx scripts/launcher/launcher-cli.ts start --mode=dev",
    "launch:staging": "tsx scripts/launcher/launcher-cli.ts start --mode=staging",
    "launch:prod": "tsx scripts/launcher/launcher-cli.ts start --mode=production",
    "launch:status": "tsx scripts/launcher/launcher-cli.ts status",
    "launch:health": "tsx scripts/launcher/launcher-cli.ts health",
    "launch:ci-smoke": "tsx scripts/launcher/launcher-ci-smoke.ts",
    "gate:cluster:acceptance": "bash ./scripts/ops/cluster-websocket-gate.sh",
    "test:gateway:browser-mainline": "vitest run server/gateway/browser/adapter.test.ts server/gateway/openclaw-control-plane.test.ts",
    "test:gateway:writeback-mainline": "vitest run server/gateway/capability-writeback.test.ts",
    "test:gateway:embedding-mainline": "vitest run server/gateway/embedding-contract.test.ts",
    "test:gateway:multimodal-mainline": "vitest run server/gateway/multimodal-retrieval-contract.test.ts",
    "test:gateway:phase0-mainline": "vitest run server/gateway/control-plane-contracts.test.ts",
    "test:gateway:summary-mainline": "vitest run server/gateway/control-plane-contracts.test.ts server/gateway/openclaw-control-plane.test.ts",
    "test:gateway:projection-surface-mainline": "vitest run server/gateway/runtime-capability-surface.test.ts server/gateway/openclaw-control-plane.test.ts",
    "test:gateway:diagnostics-mainline": "vitest run server/gateway/runtime-capability-diagnostics-taxonomy.test.ts server/gateway/runtime-capability-surface.test.ts server/gateway/runtime-capability-stable-diagnostics-subset.test.ts",
    "test:gateway:consumer-diagnostics-mainline": "vitest run server/gateway/runtime-capability-cross-surface-consistency.test.ts server/gateway/runtime-capability-diagnostics-taxonomy.test.ts server/gateway/runtime-capability-stable-diagnostics-subset.test.ts server/gateway/runtime-capability-surface.test.ts server/gateway/runtime-capability-proof.test.ts",
    "test:gateway:runtime-capability-mainline": "npm run test:gateway:browser-mainline && npm run test:gateway:context-mainline && npm run test:gateway:embedding-mainline && npm run test:gateway:multimodal-mainline",
    "gate:gateway:browser": "npm run test:gateway:browser-mainline && npm run typecheck:test",
    "gate:gateway:embedding": "npm run test:gateway:embedding-mainline && npm run typecheck:test",
    "gate:gateway:multimodal": "npm run test:gateway:multimodal-mainline && npm run typecheck:test",
    "test:gateway:context-mainline": "vitest run server/gateway/context-contract.test.ts",
    "gate:gateway:context": "npm run test:gateway:context-mainline && npm run typecheck:test",
    "check:gateway:phase0:docs": "tsx scripts/checks/check-gateway-phase0-contracts.ts",
    "check:gateway:summary:docs": "tsx scripts/checks/check-gateway-summary-contracts.ts",
    "check:gateway:diagnostics:docs": "tsx scripts/checks/check-gateway-diagnostics-taxonomy.ts",
    "check:gateway:stable-diagnostics-subset:docs": "tsx scripts/checks/check-gateway-stable-diagnostics-subset.ts",
    "check:gateway:projection-surface:docs": "tsx scripts/checks/check-gateway-summary-contracts.ts",
    "check:gateway:writeback:proof": "tsx scripts/checks/check-capability-writeback-proof.ts",
    "gate:gateway:phase0": "npm run typecheck && npm run check:gateway:phase0:docs && npm run test:gateway:phase0-mainline",
    "gate:gateway:contract-boundary": "npm run gate:gateway:phase0",
    "gate:gateway:summary": "npm run typecheck && npm run check:gateway:summary:docs && npm run test:gateway:summary-mainline",
    "gate:gateway:diagnostics": "npm run typecheck && npm run check:gateway:diagnostics:docs && npm run test:gateway:diagnostics-mainline",
    "gate:gateway:identity-diagnostics": "npm run check:gateway:diagnostics:docs && vitest run server/gateway/runtime-capability-diagnostics-taxonomy.test.ts",
    "gate:gateway:status-card-diagnostics": "npm run check:gateway:diagnostics:docs && vitest run server/gateway/runtime-capability-surface.test.ts server/gateway/runtime-capability-diagnostics-taxonomy.test.ts",
    "gate:gateway:stable-diagnostics-subset": "npm run typecheck && npm run check:gateway:stable-diagnostics-subset:docs && vitest run server/gateway/runtime-capability-stable-diagnostics-subset.test.ts server/gateway/runtime-capability-surface.test.ts",
    "gate:gateway:consumer-diagnostics": "npm run typecheck && npm run check:gateway:diagnostics:docs && npm run check:gateway:stable-diagnostics-subset:docs && npm run test:gateway:consumer-diagnostics-mainline",
    "gate:gateway:writeback": "npm run test:gateway:writeback-mainline",
    "gate:gateway:capability-absorb": "npm run gate:gateway:writeback",
    "gate:gateway:projection-surface": "npm run typecheck && npm run check:gateway:projection-surface:docs && npm run test:gateway:projection-surface-mainline",
    "gate:gateway:runtime-capability-surface": "npm run gate:gateway:projection-surface",
    "gate:gateway:writeback-to-surface": "npm run typecheck && npm run test:gateway:writeback-mainline && npm run test:gateway:projection-surface-mainline",
    "gate:gateway:runtime-capability": "npm run typecheck && npm run typecheck:test && npm run test:gateway:runtime-capability-mainline && npm run gate:gateway:projection-surface && npm run test:gateway:mainline",
    "gate:gateway:submit-ready": "npm run check:contract:strict && npm run check:contract:drift && vitest run server/bootstrap/createNegentropyServer.security.test.ts server/bootstrap/serverProcessOptions.test.ts server/gateway/auth-mode.test.ts server/gateway/openclaw-node-pending.test.ts server/gateway/openclaw-pairing.test.ts server/gateway/browser/adapter.test.ts server/gateway/openclaw-control-plane.test.ts && npm run typecheck:test",
    "test:gateway:mainline": "npm run test:gateway:browser-mainline && npm run test:gateway:context-mainline && npm run test:gateway:embedding-mainline && npm run test:gateway:multimodal-mainline && vitest run server/gateway/auth/test/auth-integration.test.ts server/gateway/llm/__tests__/*.test.ts server/gateway/llm/adapters/__tests__/*.test.ts server/gateway/openclaw-orchestration/__tests__/*.test.ts server/gateway/openclaw-decision/__tests__/*.test.ts server/gateway/resilience/__tests__/*.test.ts",
    "test:cluster": "vitest run server/cluster/**/*.test.ts server/discovery/mdns/MDNSDiscoverer.test.ts",
    "test:cluster:e2e": "vitest run server/cluster/__tests__/cluster-e2e.test.ts server/cluster/__tests__/cluster-websocket-e2e.test.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.15.0",
    "@colyseus/monitor": "^0.15.0",
    "@colyseus/schema": "^2.0.0",
    "@colyseus/ws-transport": "^0.15.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "colyseus": "^0.15.0",
    "compression": "^1.7.4",
    "connect-redis": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-jwt": "^8.4.1",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "inversify": "^6.0.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multicast-dns": "^7.2.5",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^4.3.11",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.6",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.2.0",
    "chai": "^4.3.10",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "control-plane",
    "gateway",
    "websocket",
    "colyseus",
    "agent",
    "llm",
    "chat",
    "realtime",
    "negentropy"
  ],
  "author": "Negentropy-Lab Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wsman/Negentropy-Lab.git"
  }
}
